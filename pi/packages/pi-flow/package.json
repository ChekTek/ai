{
    "name": "local-pi-flow",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "Live conversation graph canvas for Pi sessions.",
    "prettier": "@elgato/prettier-config",
    "pi": {
        "extensions": [
            "./index.ts"
        ]
    },
    "scripts": {
        "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p web/tsconfig.json",
        "lint": "eslint . --max-warnings 0",
        "build": "pnpm run typecheck && pnpm run lint"
    },
    "dependencies": {
        "ws": "8.21.3"
    },
    "devDependencies": {
        "@earendil-works/pi-coding-agent": "0.84.2",
        "@elgato/eslint-config": "^0.3.2",
        "@elgato/prettier-config": "^0.3.3",
        "@eslint/js": "9.39.5",
        "@types/node": "24.10.6",
        "@types/ws": "8.18.1",
        "eslint": "9.39.5",
        "globals": "^17.11.0",
        "prettier": "^3.9.6",
        "typescript": "5.9.3",
        "typescript-eslint": "8.67.0"
    }
}
